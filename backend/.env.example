# Environment variables
PORT=8080
DATABASE_URL=sqlite://./minepanel.db
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENVIRONMENT=development

# Server paths
MINECRAFT_SERVERS_PATH=/opt/minecraft/servers
JAVA_PATH=/usr/bin/java

# File upload limits
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=.jar,.zip,.txt,.yml,.yaml,.json,.properties
