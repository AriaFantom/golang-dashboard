# Copy this file to .env and adjust values as needed
POSTGRES_DB=minepanel
POSTGRES_USER=minepanel
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
TZ=UTC

# For running the Go backend locally against the containerized DB
# Use localhost because the app runs on the host, not in Docker
DATABASE_URL=postgres://minepanel:change-me@localhost:5432/minepanel?sslmode=disable
